# Environment
ENVIRONMENT=development

# Coralogix Configuration
# Get your private key from: https://dashboard.coralogix.com/settings/send-your-data
CORALOGIX_PRIVATE_KEY=your-private-key-here
CORALOGIX_APP_NAME=orders
# Choose your Coralogix domain based on your region:
# EU1: ingress.coralogix.com
# EU2: ingress.eu2.coralogix.com (default)
# US1: ingress.coralogix.us
# US2: ingress.cx498.coralogix.com
# AP1: ingress.coralogixsg.com
# AP2: ingress.app.coralogix.in
CORALOGIX_DOMAIN=ingress.eu2.coralogix.com
