ENVIRONMENT=development

HTTP_PORT=8001

ORDER_API_SERVICE_NAME=order-api
ORDER_WORKER_SERVICE_NAME=order-worker
ORDER_CONSUMER_SERVICE_NAME=order-consumer

OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT_HTTP=localhost:4318

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=26257
DB_USER=root
DB_PASSWORD=order@password
DB_NAME=orders
DB_MAX_IDLE_CONNS=10
MIGRATE_PATH=file://migrations/order

KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_TOPIC=orders
KAFKA_ORDER_DLQ_TOPIC=orders-dlq
KAFKA_ORDER_NUM_PARTITIONS=1
KAFKA_ORDER_REPLICATION_FACTOR=1
KAFKA_ORDER_GROUP_ID=order-group

WORKER_CRON=* * * * *