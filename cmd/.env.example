ENVIRONMENT=development

HTTP_PORT=8001

ORDER_API_SERVICE_NAME=order-api
ORDER_WORKER_SERVICE_NAME=order-worker
ORDER_CONSUMER_SERVICE_NAME=order-consumer

OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_LOG_LEVEL=info
OTEL_LOG_FORMAT=json
OTEL_TRACE_SAMPLE_RATE=1.0

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=26257
DB_USER=root
DB_PASSWORD=order@password
DB_NAME=orders
DB_MAX_IDLE_CONNS=10
MIGRATE_PATH=file://migrations/order

KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_TOPIC=orders
KAFKA_ORDER_DLQ_TOPIC=orders-dlq
KAFKA_ORDER_NUM_PARTITIONS=1
KAFKA_ORDER_REPLICATION_FACTOR=1
KAFKA_ORDER_GROUP_ID=order-group

WORKER_CRON=* * * * *

# Client Service Configuration
CLIENT_SERVICE_URL=http://localhost:8080
CLIENT_SERVICE_TIMEOUT=30s
CLIENT_MAX_RETRIES=3
CLIENT_INITIAL_RETRY_DELAY=100ms
CLIENT_MAX_RETRY_DELAY=2s
CLIENT_RETRYABLE_STATUS_CODES=408,429,500,502,503,504