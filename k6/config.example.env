# K6 Load Testing Configuration
# Copy this file to config.env and customize as needed

# Base URL of the service to test
BASE_URL=http://localhost:8001

# K6 Test Configuration
K6_VUS=100                    # Number of virtual users
K6_DURATION=5m                # Test duration
K6_ITERATIONS=1000            # Number of iterations (optional)

# Thresholds Configuration
K6_THRESHOLD_P95=500          # P95 response time threshold (ms)
K6_THRESHOLD_P99=1000         # P99 response time threshold (ms)
K6_ERROR_RATE=0.05            # Maximum error rate (5%)

# Output Configuration
K6_OUT_DIR=results            # Directory to save results
K6_SUMMARY_EXPORT=true        # Export summary to JSON

# Test Data Configuration
NUM_CLIENTS=5                 # Number of different client IDs to use
NUM_PRODUCTS=5                # Number of different products to use
MIN_ITEMS_PER_ORDER=1         # Minimum items per order
MAX_ITEMS_PER_ORDER=3         # Maximum items per order
MIN_QUANTITY=1                # Minimum quantity per item
MAX_QUANTITY=5                # Maximum quantity per item

# Timing Configuration
SLEEP_BETWEEN_REQUESTS=1      # Sleep time between requests (seconds)
SLEEP_BEFORE_PAYMENT=2        # Sleep time before marking as paid (seconds)
